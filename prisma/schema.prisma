// Jarvis Comps — Prisma schema
// Postgres (Neon). Schema is synced with `prisma db push`; no committed
// migration history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  // Access flag, set manually by an admin: "active" grants the product,
  // anything else revokes it. See src/lib/entitlements.ts.
  entitlement  String    @default("active")
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model InviteCode {
  code         String    @id
  createdAt    DateTime  @default(now())
  // Burned on redemption. A non-null usedAt means the code is spent; the
  // atomic claim in src/lib/invites.ts guards on usedAt being null.
  usedAt       DateTime?
  usedByUserId String?

  @@index([usedAt])
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
